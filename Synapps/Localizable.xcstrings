    "%@ / %@" : {
      "comment" : "Displays the current card index and the total number of cards.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"

#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! command -v swiftformat >/dev/null 2>&1; then
  echo "SwiftFormat не найден. Установите: brew install swiftformat" >&2
  exit 1
fi

files=()
while IFS= read -r -d '' f; do
  files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

if [ -f .swiftformat ]; then
  swiftformat --config .swiftformat "${files[@]}"
else
  swiftformat "${files[@]}"
fi

changed=()
while IFS= read -r -d '' f; do
  changed+=("$f")
done < <(git diff --name-only -z -- "${files[@]}")

if [ ${#changed[@]} -gt 0 ]; then
  echo "SwiftFormat внёс изменения в ${#changed[@]} файл(ах):"
  for f in "${changed[@]}"; do
    printf ' - %s\n' "$f"
  done
  echo "Коммит отменён. Добавьте изменения и повторите коммит."
  exit 1
fi

exit 0
